        "rocket_nose_cone.gcode.3mf": 1,
        "rocket_fin.gcode.3mf": 4,
        "avionics_bay.gcode.3mf": 1,
        "engine_mount": 1,
        "nozzle_insert": 1,
        "fuel_tank_weld": 1,
        "body_tube_layup": 1,
